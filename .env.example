# Database
DATABASE_URL=postgresql://codepad:codepad@localhost:5432/codepad
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Execution Engine
EXECUTION_ENGINE_URL=http://localhost:8081
MAX_CONTAINER_MEMORY_MB=512
MAX_CONTAINER_CPU_CORES=1
CONTAINER_IDLE_TIMEOUT_SEC=1800
CONTAINER_MAX_LIFETIME_SEC=3600
MAX_OUTPUT_BUFFER_BYTES=1048576

# Collaboration
COLLABORATION_WS_PORT=8082
CRDT_SNAPSHOT_INTERVAL_SEC=30

# S3 / Object Storage
S3_BUCKET=codepad-sessions
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application
NODE_ENV=development
API_PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# LiveKit (Video/Audio)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
